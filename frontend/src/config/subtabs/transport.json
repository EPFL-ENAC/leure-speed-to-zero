{
  "kpis": [
    {
      "name": {
        "enUS": "Total transport emissions",
        "frFR": "Émissions totales des transports",
        "deDE": "Gesamtemissionen Verkehr"
      },
      "unit": "Mt CO₂eq",
      "route": "emissions",
      "maximize": false,
      "info": {
        "enUS": "Direct (scope 1) greenhouse gas emissions in 2050 from all passenger and freight transport, aviation included. Electricity-related emissions are attributed to the power sector, not to transport. Aviation is counted on a residency basis, covering the full round trip of residents' flights.",
        "frFR": "Émissions directes (périmètre 1) de gaz à effet de serre en 2050 pour l'ensemble du transport de passagers et de marchandises, aviation comprise. Les émissions liées à l'électricité sont attribuées au secteur de l'énergie et non aux transports. L'aviation est comptabilisée sur une base de résidence, couvrant l'aller-retour complet des vols des résidents.",
        "deDE": "Direkte Treibhausgasemissionen (Scope 1) im Jahr 2050 aus dem gesamten Personen- und Güterverkehr, einschliesslich Luftverkehr. Strombedingte Emissionen werden dem Energiesektor zugerechnet, nicht dem Verkehr. Der Luftverkehr wird nach dem Wohnsitzprinzip erfasst und umfasst den gesamten Hin- und Rückflug der Einwohner."
      }
    },
    {
      "name": {
        "enUS": "Total transport energy demand",
        "frFR": "Demande énergétique totale des transports",
        "deDE": "Gesamtenergiebedarf Verkehr"
      },
      "unit": "TWh",
      "route": "energy",
      "maximize": false,
      "info": {
        "enUS": "Total final energy demand in 2050 across all passenger and freight transport modes, aviation included, over all energy carriers.",
        "frFR": "Demande d'énergie finale totale en 2050 pour tous les modes de transport de passagers et de marchandises, aviation comprise, tous vecteurs énergétiques confondus.",
        "deDE": "Gesamter Endenergiebedarf im Jahr 2050 über alle Personen- und Güterverkehrsträger, einschliesslich Luftverkehr, über alle Energieträger."
      }
    },
    {
      "name": {
        "enUS": "Electric car share",
        "frFR": "Part de voitures électriques",
        "deDE": "Elektroauto-Anteil"
      },
      "unit": "%",
      "route": "fleet",
      "maximize": true,
      "info": {
        "enUS": "Share of electric vehicles in the passenger car fleet.",
        "frFR": "Part des véhicules électriques dans le parc de voitures particulières.",
        "deDE": "Anteil der Elektrofahrzeuge am Pkw-Bestand."
      }
    }
  ],
